# Noha AI Assistant Configuration Example
# Copy this file to .env and insert your API keys

# Groq Cloud API Key (Get at: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (Get at: https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AgentRouter API Key (Get at: https://agentrouter.to) - Optional
AGENTROUTER_API_KEY=your_agentrouter_api_key_here

# Default Active Provider (groq | openrouter | agentrouter)
NOHA_ACTIVE_PROVIDER=groq
NOHA_ACTIVE_MODEL=llama-3.3-70b-versatile
